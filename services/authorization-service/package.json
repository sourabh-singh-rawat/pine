{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/authorization-service",
  "version": "0.6.1",
  "description": "Authorization service — graph checks and relationship writes (Ory Keto)",
  "keywords": [
    "authorization",
    "keto"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/pine#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/pine/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/pine.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9236 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@ory/keto-client": "26.2.0",
    "@ory/keto-namespace-types": "0.13.0-alpha.0",
    "@pine/authorization": "workspace:^",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/identity": "workspace:^",
    "@pine/observability": "workspace:*",
    "@pine/security": "workspace:^",
    "@pine/server": "workspace:^",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@pothos/plugin-scope-auth": "^4.1.7",
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
