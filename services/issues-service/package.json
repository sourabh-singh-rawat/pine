{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/issues-service",
  "version": "0.6.1",
  "description": "Issues, projects, workspaces, and statuses",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9231 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@pine/authorization": "workspace:*",
    "@pine/common": "workspace:*",
    "@pine/errors": "workspace:*",
    "@pine/events": "workspace:*",
    "@pine/server": "workspace:*",
    "@pine/identity": "workspace:*",
    "@pine/outbox": "workspace:*",
    "@pine/security": "workspace:*",
    "@pothos/core": "^4.13.1",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "graphql-scalars": "^1.25.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
