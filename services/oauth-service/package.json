{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/oauth-service",
  "version": "0.8.0",
  "description": "OAuth service — OAuth 2.0 / OIDC authorization server (Ory Hydra)",
  "keywords": [
    "hydra",
    "oauth",
    "oidc"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/pine#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/pine/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/pine.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9241 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@ory/hydra-client": "26.2.0",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/identity": "workspace:^",
    "@pine/observability": "workspace:*",
    "@pine/server": "workspace:^",
    "axios": "^1.18.1",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
