{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/attachment-service",
  "version": "0.5.3",
  "description": "Manage attachments",
  "keywords": [
    "attachment",
    "attachment-service"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/pine#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/pine/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/pine.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9232 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1112.0",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/identity": "workspace:^",
    "@pine/outbox": "workspace:^",
    "@pine/security": "workspace:^",
    "@pine/server": "workspace:^",
    "@pothos/core": "^4.13.1",
    "bullmq": "^5.81.0",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "graphql-scalars": "^1.25.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "ioredis": "^5.11.1",
    "nats": "^2.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
