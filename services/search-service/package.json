{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/search-service",
  "version": "0.1.0",
  "description": "Search service",
  "keywords": [
    "search",
    "search-service"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/pine#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/pine/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/pine.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9242 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc"
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.9.0",
    "@pine/common": "workspace:^",
    "@pine/server": "workspace:^",
    "inversify": "8.2.2",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
