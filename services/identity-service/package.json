{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/identity-service",
  "version": "0.6.3",
  "description": "Identity service — authentication and authorization",
  "keywords": [
    "authentication",
    "identity",
    "user"
  ],
  "homepage": "https://github.com/sourabh-singh-rawat/pine#readme",
  "bugs": {
    "url": "https://github.com/sourabh-singh-rawat/pine/issues"
  },
  "license": "ISC",
  "author": "Sourabh Singh Rawat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourabh-singh-rawat/pine.git"
  },
  "main": "./src/main.ts",
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "start": "tsx --env-file=../../.env src/main.ts",
    "dev": "tsx watch --inspect=9230 --env-file=../../.env src/main.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cli:bootstrap-admin": "tsx --env-file=../../.env src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@ory/hydra-client": "26.2.0",
    "@ory/kratos-client": "26.2.0",
    "@pine/attachment": "workspace:^",
    "@pine/authorization": "workspace:^",
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "@pine/events": "workspace:^",
    "@pine/identity": "workspace:^",
    "@pine/observability": "workspace:*",
    "@pine/outbox": "workspace:^",
    "@pine/security": "workspace:^",
    "@pine/server": "workspace:^",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-scope-auth": "^4.1.7",
    "axios": "^1.18.1",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "graphql-scalars": "^1.25.0",
    "http-status-codes": "^2.3.0",
    "inversify": "8.2.2",
    "nats": "^2.29.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.3",
    "typebox": "1.3.6",
    "typescript-json-schema": "^0.68.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
