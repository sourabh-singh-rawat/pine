{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/outbox",
  "version": "0.1.3",
  "private": true,
  "description": "Transactional outbox utilities for Pine",
  "keywords": [],
  "license": "ISC",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "build": "pnpm clean && tsc",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@pine/common": "workspace:^",
    "@pine/errors": "workspace:^",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
