{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pine/ui",
  "version": "0.1.1",
  "private": true,
  "description": "Shared React UI primitives for Pine web apps (app bars, forms, modals, buttons)",
  "keywords": [
    "forms",
    "mui",
    "react",
    "tanstack-form",
    "tanstack-table",
    "ui"
  ],
  "license": "ISC",
  "author": "",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./appBars": {
      "types": "./src/appBars/index.ts",
      "default": "./src/appBars/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./src/theme/index.ts"
    }
  },
  "scripts": {
    "clean": "node ../../tools/scripts/setup/rm-rf.mjs dist",
    "build": "pnpm clean && tsc"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "6.1.9",
    "@mui/material": "6.1.9",
    "@mui/system": "6.1.9",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": ">=6.0.0",
    "@mui/material": ">=6.0.0",
    "@mui/system": ">=6.0.0",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-table": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
