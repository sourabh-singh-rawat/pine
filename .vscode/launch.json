{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "attach: all",
      "stopAll": true,
      "configurations": [
        "attach: identity-service",
        "attach: issues-service",
        "attach: attachment-service",
        "attach: attachment-scanner-service",
        "attach: notification-service",
        "attach: platform-service",
        "attach: authorization-service",
        "attach: audit-service",
        "attach: api-gateway",
        "attach: data-gateway"
      ]
    }
  ],
  "configurations": [
    {
      "name": "attach",
      "type": "node",
      "request": "attach",
      "processId": "${command:PickProcess}",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: identity-service",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: issues-service",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: attachment-service",
      "type": "node",
      "request": "attach",
      "port": 9232,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: attachment-scanner-service",
      "type": "node",
      "request": "attach",
      "port": 9233,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: notification-service",
      "type": "node",
      "request": "attach",
      "port": 9234,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: platform-service",
      "type": "node",
      "request": "attach",
      "port": 9235,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: authorization-service",
      "type": "node",
      "request": "attach",
      "port": 9236,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: audit-service",
      "type": "node",
      "request": "attach",
      "port": 9239,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: api-gateway",
      "type": "node",
      "request": "attach",
      "port": 9237,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "attach: data-gateway",
      "type": "node",
      "request": "attach",
      "port": 9238,
      "restart": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
