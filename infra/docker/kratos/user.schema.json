{
  "$id": "https://schemas.pine.local/identity/user.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "username": {
          "title": "Username",
          "description": "3–30 lowercase letters, numbers, '.' or '_'. Must start with a letter.",
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z][a-z0-9._]*[a-z0-9]$",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "phone": {
          "title": "Phone Number",
          "description": "Phone number in E.164 format.",
          "type": "string",
          "pattern": "^\\+[1-9]\\d{1,14}$",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "email": {
          "title": "Email Address",
          "type": "string",
          "format": "email",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            }
          }
        }
      },
      "required": ["username", "email"],
      "additionalProperties": false
    }
  },
  "required": ["traits"],
  "additionalProperties": false
}
